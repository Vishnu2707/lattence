#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
pattern=$(cat "$root/.githooks/prose-pattern.txt")

if [ "${1:-}" = "--cached" ]; then
  set -- git grep --cached -nI -i -E "$pattern"
else
  set -- git grep -nI -i -E "$pattern"
fi

if "$@" -- '*.md'; then
  echo "prose check failed" >&2
  exit 1
fi
