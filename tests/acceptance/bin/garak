#!/bin/sh

report_prefix=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--report_prefix" ]; then
    report_prefix="$2"
    shift 2
  else
    shift
  fi
done

if [ -z "$report_prefix" ]; then
  echo "missing report prefix" >&2
  exit 2
fi

echo '{"entry_type":"eval","probe":"fixture.Inject","detector":"fixture.Match","passed":0,"total":1}' > "${report_prefix}.report.jsonl"
